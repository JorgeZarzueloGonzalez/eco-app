<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la lista de canciones: portada + nombre + intérpretes.
     El fondo lo pinta el adaptador (tonos alternos), por eso el color del texto
     es fijo (se lee sobre los dos índigos). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/portadaCancion"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/portada" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nombreCancionFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/interpretesCancionFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_primary"
            android:textSize="14sp" />

    </LinearLayout>
</LinearLayout>
