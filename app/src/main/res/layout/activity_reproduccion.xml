<?xml version="1.0" encoding="utf-8"?>
<!-- P13 Reproducciones (las "partidas" del enunciado): elegir canción, ver sus
     reproducciones y su total, y registrar una nueva (fecha, puntuación y oyente). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.activities.ReproduccionActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reproduccion_cancion"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/cancionesReproduccionSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/totalReproducciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Reproducciones: 3" />

        <!-- ===== Nueva reproducción ===== -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/reproduccion_oyente">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/oyenteReproduccionEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/puntuacionReproduccionTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="Puntuación: 5" />

        <com.google.android.material.slider.Slider
            android:id="@+id/puntuacionReproduccionSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/reproduccion_puntuacion_label"
            android:stepSize="1"
            android:value="5"
            android:valueFrom="1"
            android:valueTo="9"
            app:labelBehavior="floating" />

        <Button
            android:id="@+id/guardarReproduccionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reproduccion_guardar" />

        <TextView
            android:id="@+id/reproduccionesVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/reproduccion_vacio"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/reproduccionesRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    </LinearLayout>
</LinearLayout>
