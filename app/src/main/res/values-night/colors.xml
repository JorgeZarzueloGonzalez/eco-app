<?xml version="1.0" encoding="utf-8"?>
<!-- Paleta de Eco · TEMA OSCURO
     Idea: grafito con un toque violeta (no negro puro, que cansa la vista y
     deja las tarjetas "flotando" sin profundidad). Cada nivel de superficie
     es un poco más claro que el anterior: así se ve la elevación sin sombras.
     El lima brilla sobre el oscuro y es a la vez acción y control. -->
<resources>
    <!-- ===== MARCA ===== -->
    <color name="primary">#6C5CE7</color>
    <color name="primaryDark">#3E32A8</color>
    <color name="accent">#C6F135</color>           <!-- en oscuro el lima sí vale para texto (14:1) -->
    <color name="accent_fill">#C6F135</color>
    <color name="action">#C6F135</color>
    <color name="control">#C6F135</color>
    <color name="on_control">#141A05</color>

    <!-- ===== CONTENEDORES ===== -->
    <color name="primary_container">#33410F</color>
    <color name="on_primary_container">#DDF78F</color>
    <color name="secondary_container">#2C2752</color> <!-- botones tonales: violeta apagado -->
    <color name="on_secondary_container">#DCD7FF</color>

    <!-- ===== SUPERFICIES (de más hundida a más elevada) ===== -->
    <color name="background">#0F0F16</color>
    <color name="surface">#14141D</color>
    <color name="surface_container_low">#181822</color>
    <color name="surface_container">#1D1D29</color>   <!-- tarjetas -->
    <color name="surface_container_high">#252533</color>
    <color name="surface_container_highest">#2D2D3D</color>
    <color name="surface_highlight">#232B12</color>
    <color name="divider">#2A2A39</color>
    <color name="outline">#4A4A5F</color>

    <!-- ===== TEXTO ===== -->
    <color name="text">#F1F1F6</color>
    <color name="text_secondary">#A3A3B7</color>
    <color name="text_on_primary">#FFFFFF</color>
    <color name="text_on_accent">#141A05</color>

    <!-- ===== ESTADO DE LA CANCIÓN ===== -->
    <color name="estado_nuevo">#7FE3C4</color>
    <color name="estado_escuchado">#B4ACFF</color>
    <color name="estado_favorito">#C6F135</color>
</resources>
