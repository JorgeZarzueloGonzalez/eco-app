<?xml version="1.0" encoding="utf-8"?>
<!-- Logo de Eco: un punto (la fuente del sonido) y tres ondas que se van apagando: el "eco".
     Lienzo de 108x108 del icono adaptativo; todo cabe en la zona segura (círculo de radio 33). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Fuente del sonido -->
    <path
        android:fillColor="#C6F135"
        android:pathData="M40,54m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />
    <!-- Onda 1 (la más fuerte) -->
    <path
        android:pathData="M49.64,42.51 A15,15 0 0,1 49.64,65.49"
        android:strokeWidth="5"
        android:strokeColor="#C6F135"
        android:strokeLineCap="round" />
    <!-- Onda 2 -->
    <path
        android:pathData="M55.43,35.62 A24,24 0 0,1 55.43,72.38"
        android:strokeAlpha="0.7"
        android:strokeWidth="5"
        android:strokeColor="#C6F135"
        android:strokeLineCap="round" />
    <!-- Onda 3 (la más débil: el eco que se apaga) -->
    <path
        android:pathData="M61.21,28.72 A33,33 0 0,1 61.21,79.28"
        android:strokeAlpha="0.4"
        android:strokeWidth="5"
        android:strokeColor="#C6F135"
        android:strokeLineCap="round" />
</vector>
