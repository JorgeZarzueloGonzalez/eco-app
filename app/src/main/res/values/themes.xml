<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema único de Eco para claro y oscuro: los colores cambian solos porque
         cada @color tiene dos versiones (values/colors.xml y values-night/colors.xml). -->
    <style name="Base.Theme.Eco" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- ===== MARCA: lima = ACCIÓN (botones principales), violeta = estructura ===== -->
        <item name="colorPrimary">@color/action</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="colorTertiary">@color/primary</item>

        <!-- Controles finos (RatingBar, cursor, etc.): lima en oscuro, violeta en claro -->
        <item name="colorControlActivated">@color/control</item>
        <item name="colorAccent">@color/control</item>

        <!-- ===== FONDO Y SUPERFICIES ===== -->
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorOnBackground">@color/text</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceDim">@color/background</item>
        <item name="colorSurfaceBright">@color/surface_container_high</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- ===== BORDES / LÍNEAS ===== -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <!-- ===== ESTILOS DE COMPONENTES ===== -->
        <item name="toolbarStyle">@style/Widget.Eco.Toolbar</item>
        <item name="checkboxStyle">@style/Widget.Eco.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.Eco.RadioButton</item>
        <item name="materialSwitchStyle">@style/Widget.Eco.Switch</item>
        <item name="textInputStyle">@style/Widget.Eco.TextInput</item>
        <item name="sliderStyle">@style/Widget.Eco.Slider</item>

        <!-- ===== BARRA DE ESTADO / NAVEGACIÓN: del color del fondo ===== -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/background</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/background</item>
        <!-- true = iconos oscuros (tema claro); false = iconos claros (tema oscuro) -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/barras_claras</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">@bool/barras_claras</item>
    </style>

    <style name="Theme.Eco" parent="Base.Theme.Eco" />

    <!-- Toolbar del mismo color que el fondo: la pantalla se ve como una sola pieza -->
    <style name="Widget.Eco.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/background</item>
        <item name="titleTextColor">@color/text</item>
    </style>

    <!-- Los controles cambian colorPrimary por el color de control (ThemeOverlay):
         en claro, violeta (el lima no se ve sobre blanco); en oscuro, lima. -->
    <style name="ThemeOverlay.Eco.Control" parent="">
        <item name="colorPrimary">@color/control</item>
        <item name="colorOnPrimary">@color/on_control</item>
    </style>

    <style name="Widget.Eco.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="materialThemeOverlay">@style/ThemeOverlay.Eco.Control</item>
    </style>

    <style name="Widget.Eco.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="materialThemeOverlay">@style/ThemeOverlay.Eco.Control</item>
    </style>

    <style name="Widget.Eco.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="materialThemeOverlay">@style/ThemeOverlay.Eco.Control</item>
    </style>

    <style name="Widget.Eco.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="materialThemeOverlay">@style/ThemeOverlay.Eco.TextInput</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="ThemeOverlay.Eco.TextInput" parent="ThemeOverlay.Material3.TextInputEditText.OutlinedBox">
        <item name="colorPrimary">@color/control</item>
        <item name="colorOnPrimary">@color/on_control</item>
    </style>

    <style name="Widget.Eco.Slider" parent="Widget.Material3.Slider">
        <item name="materialThemeOverlay">@style/ThemeOverlay.Eco.Control</item>
    </style>
</resources>
